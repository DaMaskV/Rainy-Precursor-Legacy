       (not (rainy-p09-mayor-wall-core-column? pos))))

;; P11 PRIVATE camera-effect provenance diagnostic. Counts do not change weather decisions.
;; These are cumulative event requests and effect spawn calls, NOT visible droplet counts.
(define *rainy-p11-legacy-requests* 0)
(define *rainy-p11-dynamic-requests* 0)
(define *rainy-p11-request-player-core* 0)
(define *rainy-p11-request-camera-core* 0)
(define *rainy-p11-request-camera-edge* 0)
(define *rainy-p11-request-player-core-camera-out* 0)
(define *rainy-p11-effect-spawns* 0)
(define *rainy-p11-effect-spawns-closed-cache* 0)
(define *rainy-p11-effect-spawns-player-core* 0)
(define *rainy-p11-effect-spawns-player-core-closed-cache* 0)

(defun rainy-p11-record-request ((who target))
  ;; Called only on a branch that actually requests part-water-drip.
  (let ((player-pos (-> who control trans))
        (camera-pos (math-camera-pos)))
    (when (rainy-p09-mayor-wall-core-column? player-pos)
      (+! *rainy-p11-request-player-core* 1)
      (when (not (or (rainy-p09-mayor-wall-core-column? camera-pos)
                     (rainy-p10-mayor-edge-column? camera-pos)))
        (+! *rainy-p11-request-player-core-camera-out* 1)))
    (when (rainy-p09-mayor-wall-core-column? camera-pos)
      (+! *rainy-p11-request-camera-core* 1))
    (when (rainy-p10-mayor-edge-column? camera-pos)
      (+! *rainy-p11-request-camera-edge* 1)))
  (none))

;; P04: screen-water camera shelter now handles one-sided collidable ceilings.
;; World-space particle clipping, weather, lightning, and Legacy art unchanged.
(define *rainy-p04-camera-down-hits* 0)
(define *rainy-p04-camera-up-tests* 0)
(define *rainy-p04-camera-up-hits* 0)

(defun rainy-shelter-camera-open? ()
  (when (> (- (current-time) *rainy-shelter-view-time*) (seconds 0.2))
    (set! *rainy-shelter-view-time* (current-time))
    (let ((origin (new 'stack-no-clear 'vector))
          (line (new 'stack-no-clear 'vector))
          (hit (new 'stack-no-clear 'collide-tri-result))
          (covered #f))
      ;; Preserve P03's existing downward cover check first.
      (vector-copy! origin (math-camera-pos))
      (+! (-> origin y) (meters 64.0))
      (set-vector! line 0.0 (meters -63.75) 0.0 0.0)
      (when (>= (fill-and-probe-using-line-sphere *collide-cache* origin line (meters 0.05)
                   (collide-kind background) (the-as process #f) hit
                   (new 'static 'pat-surface)) 0.0)
        (set! covered #t)
        (+! *rainy-p04-camera-down-hits* 1))
      ;; P03 proved some one-sided ceilings only answer an upward cast.
      ;; Restrict fallback to the camera's vertical column and down-facing undersides.
      (when (not covered)
        (+! *rainy-p04-camera-up-tests* 1)
        (vector-copy! origin (math-camera-pos))
        (+! (-> origin y) (meters 0.25))
        (set-vector! line 0.0 (meters 63.75) 0.0 0.0)
        (when (and (>= (fill-and-probe-using-line-sphere *collide-cache* origin line (meters 0.05)
                         (collide-kind background) (the-as process #f) hit
                         (new 'static 'pat-surface)) 0.0)
                   (< (-> hit normal y) -0.25))
          (set! covered #t)
          (+! *rainy-p04-camera-up-hits* 1)))
      ;; P08: only suppress screen droplets if the actual camera is below the
      ;; geometry-derived roof footprint, rather than Jak standing near an anchor.
      (when (and (not covered) (rainy-p08-samos-roof-column? (math-camera-pos)))
        (set! covered #t)
        (+! *rainy-p08-camera-hits* 1))
      ;; P09: independently test camera under the wall-bounded mayor interior.
      (when (and (not covered) (rainy-p09-mayor-wall-core-column? (math-camera-pos)))
        (set! covered #t)
        (+! *rainy-p09-mayor-camera-hits* 1))
      (set! *rainy-shelter-view-open* (not covered))))
  ;; P13 release stabilization: preserve P10 shelter decisions, but avoid the
  ;; two-second diagnostic burst and the extra probe rays in P03 snapshots.
  ;; Reporting is informational and not part of any rain-culling decision.
  (when (> (- (current-time) *rainy-shelter-log-time*) (seconds 30.0))
    (set! *rainy-shelter-log-time* (current-time))
    (format #t "RAINY_P13_SHELTER clipped=~D mayor_edge=~D samos=~D overflow=~D camera_open=~A~%"
            *rainy-shelter-kills* *rainy-p10-mayor-edge-culls*
            *rainy-p08-roof-culls* *rainy-shelter-overflow* *rainy-shelter-view-open*))
  *rainy-shelter-view-open*)

(defun rainy-shelter-init-and-kill? ((sys sparticle-system) (part sparticle-cpuinfo) (pos vector))
  ;; P08: kill new particles already beneath the modeled straw roof,
  ;; including when the roof is ABOVE the particle spawn-height plane.
  (when (rainy-p08-samos-roof-column? pos)
    (sp-kill-particle sys part)
    (+! *rainy-p08-roof-culls* 1)
    (+! *rainy-shelter-kills* 1)
    (return #t))
  ;; P09: newly spawned world rain in the mayor's wall-bounded interior column.
  (when (rainy-p09-mayor-wall-core-column? pos)
    (sp-kill-particle sys part)
    (+! *rainy-p09-mayor-culls* 1)
    (+! *rainy-shelter-kills* 1)
    (return #t))
  ;; P10: add only the thin wall-edge ring, keeping the P09 core unchanged.
  (when (rainy-p10-mayor-edge-column? pos)
    (sp-kill-particle sys part)
    (+! *rainy-p10-mayor-edge-culls* 1)
    (+! *rainy-shelter-kills* 1)
    (return #t))
  (when (< (-> part user-float) -900000000.0)
    (let ((frame (-> *display* real-actual-frame-counter)))
      (when (!= frame *rainy-shelter-frame*)
        (set! *rainy-shelter-frame* frame)
        (set! *rainy-shelter-frame-rays* 0)))
    (cond
      ((>= *rainy-shelter-frame-rays* 32)
       (+! *rainy-shelter-overflow* 1)
       (sp-kill-particle sys part)
       (return #t))
      (else
       (+! *rainy-shelter-frame-rays* 1)
       (+! *rainy-shelter-rays* 1)
       (set! (-> part user-float) -100000000.0)
       (let ((origin (new 'stack-no-clear 'vector))
             (line (new 'stack-no-clear 'vector))
             (hit (new 'stack-no-clear 'collide-tri-result)))
         (vector-copy! origin pos)
         (+! (-> origin y) (meters 64.0))
         (set-vector! line 0.0 (meters -96.0) 0.0 0.0)
         (when (>= (fill-and-probe-using-line-sphere *collide-cache* origin line (meters 0.05)
                     (collide-kind background) (the-as process #f) hit
                     (new 'static 'pat-surface)) 0.0)
           ;; Conservative billboard margin; geometry classification still needs playtesting.
           (set! (-> part user-float) (+ (-> hit intersect y) (meters 0.5))))))))
  ;; Only seek an underside if the downward column did not find overhead cover.
  ;; Use the emitter's standing-height plane, not a ray from far below the terrain.
  (when (and *target* (< (-> part user-float) (+ (-> *target* control trans y) (meters 1.0))))
    (cond
      ((>= *rainy-shelter-frame-rays* 32)
       (+! *rainy-shelter-overflow* 1)
       (sp-kill-particle sys part)
       (return #t))
      (else
       (+! *rainy-shelter-frame-rays* 1)
       (+! *rainy-shelter-rays* 1)
       (+! *rainy-p03-up-tests* 1)
       (let ((origin (new 'stack-no-clear 'vector))
             (line (new 'stack-no-clear 'vector))
             (hit (new 'stack-no-clear 'collide-tri-result)))
         (vector-copy! origin pos)
         (set! (-> origin y) (+ (-> *target* control trans y) (meters 1.0)))
         (set-vector! line 0.0 (meters 63.0) 0.0 0.0)
         (when (and (>= (fill-and-probe-using-line-sphere *collide-cache* origin line (meters 0.05)
                         (collide-kind background) (the-as process #f) hit
                         (new 'static 'pat-surface)) 0.0)
                    (< (-> hit normal y) -0.25))
           (+! *rainy-p03-up-hits* 1)
           (set! (-> part user-float) (fmax (-> part user-float) (+ (-> hit intersect y) (meters 0.5)))))))))
  (when (> (- (current-time) *rainy-p03-drop-log-time*) (seconds 2.0))
    (set! *rainy-p03-drop-log-time* (current-time))
    (format #t "RAINY_P03_DROP x-m=~F y-m=~F z-m=~F cutoff-m=~F~%"
            (/ (-> pos x) (meters 1.0)) (/ (-> pos y) (meters 1.0))
            (/ (-> pos z) (meters 1.0)) (/ (-> part user-float) (meters 1.0))))
  (if (< (-> pos y) (-> part user-float))
      (begin (sp-kill-particle sys part) (+! *rainy-shelter-kills* 1) #t)
      #f))

(defun rainy-shelter-kill? ((sys sparticle-system) (part sparticle-cpuinfo) (pos vector))
  ;; P08: also remove already-alive particles once their position enters
  ;; a covered column. No collision calls in update callbacks.
  (let ((under-roof (rainy-p08-samos-roof-column? pos))
        (under-mayor (rainy-p09-mayor-wall-core-column? pos))
        (under-edge (rainy-p10-mayor-edge-column? pos)))
    (if (or under-roof under-mayor under-edge
            (< (-> part user-float) -900000000.0)
            (< (-> pos y) (-> part user-float)))
        (begin
          (when under-roof (+! *rainy-p08-roof-culls* 1))
          (when under-mayor (+! *rainy-p09-mayor-culls* 1))
          (when under-edge (+! *rainy-p10-mayor-edge-culls* 1))
          (sp-kill-particle sys part)
          (+! *rainy-shelter-kills* 1)
          #t)
        #f)))

(defun rainy-shelter-drop37 ((sys sparticle-system) (part sparticle-cpuinfo) (pos vector))
  (+! *rainy-p03-calls37* 1)
  (when (not (rainy-shelter-kill? sys part pos))
    ;; Preserve original particle-37 zero-height splash fallback on unobstructed columns.
    (when (< (-> pos y) 0.0)
      (let ((point (new 'stack-no-clear 'vector)))
        (sp-kill-particle sys part)
        (set-vector! point (-> pos x) 0.0 (-> pos z) 1.0)
        (launch-particles (-> *part-id-table* 39) point :rate 1.0)
        (launch-particles :system *sp-particle-system-3d* (-> *part-id-table* 40) point :rate 1.0))))
  (none))

(defun rainy-shelter-drop38 ((sys sparticle-system) (part sparticle-cpuinfo) (pos vector))
  (+! *rainy-p03-calls38* 1)
  (rainy-shelter-kill? sys part pos)
  (none))

;; P07: flush *all existing* 37/38 rain only inside a verified test core.
;; Intentionally diagnostic: outdoor rain in the camera view also disappears.
(defun rainy-p07-kill-existing-one ((sys sparticle-system) (part sparticle-cpuinfo) (sprite pointer))
  (when (or (= (-> part func) rainy-shelter-drop37)
            (= (-> part func) rainy-shelter-drop38))
    (sp-kill-particle sys part)
    (+! *rainy-p07-existing-kills* 1))
  (none))

(defun rainy-p07-flush-existing ()
  (+! *rainy-p07-flush-calls* 1)
  ;; Uses P03-P06 main-memory traversal; does not query collision or mutate sources.
  (forall-particles rainy-p07-kill-existing-one #t #t)
  (none))

(defun rainy-shelter-prepare-one ((sys sparticle-system) (part sparticle-cpuinfo) (sprite pointer))
  (when (and (or (= (-> part func) rainy-shelter-drop37)
                 (= (-> part func) rainy-shelter-drop38))
             (< (-> part user-float) -900000000.0))
    (rainy-shelter-init-and-kill? sys part (the-as vector sprite)))
  (none))

(defun rainy-shelter-prepare-new ()
  ;; Called after both native launch-particles calls return; CPU records are in main memory.
  ;; Never call the collision engine from sp-process-block callbacks.
  (forall-particles rainy-shelter-prepare-one #t #t)
  (none))

