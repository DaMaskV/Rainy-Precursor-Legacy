(defun update-snow ((arg0 target))
  (let ((gp-0 (-> arg0 control trans)))
    (let ((f0-0 (lerp-scale 0.0 1.0 (vector-length (-> arg0 control transv)) 2048.0 40960.0)))
      (set! (-> *part-id-table* 34 init-specs 1 initial-valuef) (- 1.0 f0-0))
      (set! (-> *part-id-table* 33 init-specs 1 initial-valuef) (* 4.0 f0-0)))
    (set! (-> *part-id-table* 33 init-specs 19 initial-valuef) (+ 32768.0 (vector-y-angle (-> arg0 control transv))))
    (launch-particles (-> *part-id-table* 34) gp-0)
    (launch-particles (-> *part-id-table* 33) gp-0))
  0
  (none))

;; SHELTER P03 candidate: downward query plus one-sided ceiling fallback: private prototype, shared by both rain emitters.
;; One background column query per particle lifetime, capped at 32 per frame.
;; The cap drops excess unclassified particles rather than allowing indoor leaks.
(define *rainy-shelter-frame* -1)
(define *rainy-shelter-frame-rays* 0)
(define *rainy-shelter-rays* 0)
(define *rainy-shelter-kills* 0)
(define *rainy-shelter-overflow* 0)
(define *rainy-shelter-view-time* 0)
(define *rainy-shelter-view-open* #t)
(define *rainy-shelter-log-time* 0)

;; Diagnostic only: four comparison queries every two seconds, outside callbacks.
(define *rainy-p03-up-tests* 0)
(define *rainy-p03-up-hits* 0)
(define *rainy-p03-calls37* 0)
(define *rainy-p03-calls38* 0)
(define *rainy-p03-drop-log-time* 0)

(defun rainy-p03-probe ((label symbol) (origin vector) (line vector) (kind collide-kind))
  (let* ((hit (new 'stack-no-clear 'collide-tri-result))
         (fraction (fill-and-probe-using-line-sphere *collide-cache* origin line (meters 0.05)
                    kind (the-as process *target*) hit (new 'static 'pat-surface))))
    (format #t "RAINY_P03_PROBE label=~A t=~F prims=~D tris=~D~%"
            label fraction (-> *collide-cache* num-prims) (-> *collide-cache* num-tris))
    (when (>= fraction 0.0)
      (format #t "RAINY_P03_HIT label=~A y-m=~F normal-y=~F pat=~X~%"
              label (/ (-> hit intersect y) (meters 1.0)) (-> hit normal y) (-> hit pat))))
  (none))

(defun rainy-p03-snapshot ()
  (when *target*
    (let ((origin (new 'stack-no-clear 'vector))
          (line (new 'stack-no-clear 'vector)))
      (format #t "RAINY_P03_POS mode=~A x-m=~F y-m=~F z-m=~F calls37=~D calls38=~D~%"
              *rainy-mode* (/ (-> *target* control trans x) (meters 1.0))
              (/ (-> *target* control trans y) (meters 1.0))
              (/ (-> *target* control trans z) (meters 1.0))
              *rainy-p03-calls37* *rainy-p03-calls38*)
      (vector-copy! origin (-> *target* control trans))
      (+! (-> origin y) (meters 64.0))
      (set-vector! line 0.0 (meters -63.0) 0.0 0.0)
      (rainy-p03-probe 'down-bg origin line (collide-kind background))
      (rainy-p03-probe 'down-bg-fg origin line (collide-kind background cak-1 cak-2 cak-3))
      (vector-copy! origin (-> *target* control trans))
      (+! (-> origin y) (meters 1.0))
      (set-vector! line 0.0 (meters 63.0) 0.0 0.0)
      (rainy-p03-probe 'up-bg origin line (collide-kind background))
      (rainy-p03-probe 'up-bg-fg origin line (collide-kind background cak-1 cak-2 cak-3))))
  (none))

;; P06 PRIVATE CAUSAL DIAGNOSTIC — do not ship or merge these provisional circles.
;; Player must remain within 1.5m of the already-video-verified room center.
;; Rain columns within 4.0m of that center are removed AT SPAWN, not at a
;; height they may never reach before their 0.8-second particle lifetime ends.
;; The enlarged radius is solely for a visible A/B test; boundaries are not
;; established roof outlines and may remove rain visible through an opening.
(define *rainy-p06-spawn-culls* 0)
(define *rainy-p06-player-camera-hits* 0)

(defun rainy-p06-core-active? ((point vector))
  (if *target*
      (let ((player (-> *target* control trans)))
        (or
          (and (> (-> player y) (meters 43.0))
               (< (-> player y) (meters 50.0))
               (< (+ (* (- (-> player x) (meters -132.1793)) (- (-> player x) (meters -132.1793)))
                     (* (- (-> player z) (meters 208.5671)) (- (-> player z) (meters 208.5671))))
                  (* (meters 1.5) (meters 1.5)))
               (< (+ (* (- (-> point x) (meters -132.1793)) (- (-> point x) (meters -132.1793)))
                     (* (- (-> point z) (meters 208.5671)) (- (-> point z) (meters 208.5671))))
                  (* (meters 4.0) (meters 4.0))))
          (and (> (-> player y) (meters 7.0))
               (< (-> player y) (meters 13.0))
               (< (+ (* (- (-> player x) (meters -108.2468)) (- (-> player x) (meters -108.2468)))
                     (* (- (-> player z) (meters 39.2060)) (- (-> player z) (meters 39.2060))))
                  (* (meters 1.5) (meters 1.5)))
               (< (+ (* (- (-> point x) (meters -108.2468)) (- (-> point x) (meters -108.2468)))
                     (* (- (-> point z) (meters 39.2060)) (- (-> point z) (meters 39.2060))))
                  (* (meters 4.0) (meters 4.0))))))
      #f))

;; P07 PRIVATE SOURCE-ISOLATION A/B DIAGNOSTIC (never ship or merge).
;; The two verified player anchors pause BOTH world-space rain emitters 37/38.
;; The live-particle killer is defined after their callbacks below.
(define *rainy-p07-legacy-paused-frames* 0)
(define *rainy-p07-dynamic-paused-frames* 0)
(define *rainy-p07-existing-kills* 0)
(define *rainy-p07-flush-calls* 0)

(defun rainy-p07-player-in-test-core? ()
  (if *target*
      (rainy-p06-core-active? (-> *target* control trans))
      #f))

;; P08 PRIVATE Samos-only geometry-derived diagnostic: named straw-roof projected surface.
;; 32-vertex INSCRIBED world-space XZ polygon; NEVER inferred from a Jak radius.
;; Deliberate 0.7m radial inset and additional global shrink were checked offline.
;; Y limits guard against other vertical layers sharing the same X/Z.
;; Sky-open doorways and roof overhang boundary require actual gameplay validation.
(define *rainy-p08-roof-culls* 0)
(define *rainy-p08-camera-hits* 0)
(defun rainy-p08-samos-roof-column? ((pos vector))
  (if (and (> (-> pos x) (meters -143.746609))
           (< (-> pos x) (meters -119.903226))
           (> (-> pos y) (meters 45.0))
           (< (-> pos y) (meters 76.0))
           (> (-> pos z) (meters 195.577711))
           (< (-> pos z) (meters 219.499929)))
      (let ((inside #f))
        (when (and (>= (-> pos z) (meters 207.601100))
                   (< (-> pos z) (meters 210.044654))
                   (< (-> pos x) (+ (meters -120.089210) (* (- (-> pos z) (meters 207.601100)) 0.076112089))))
          (set! inside (not inside)))
        (when (and (>= (-> pos z) (meters 210.044654))
                   (< (-> pos z) (meters 212.687653))
                   (< (-> pos x) (+ (meters -119.903226) (* (- (-> pos z) (meters 210.044654)) -0.001721529))))
